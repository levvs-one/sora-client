<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SoraUpgrade</AssemblyName>
    <RootNamespace>v2rayUpgrade</RootNamespace>
    <Product>Sora Updater</Product>
    <AssemblyTitle>Sora Updater</AssemblyTitle>
    <Authors>levvs-one</Authors>
    <Company>levvs-one</Company>
    <PackageProjectUrl>https://github.com/levvs-one/sora-client</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright © 2019-2020 v2rayN contributors; © 2026 levvs-one. GPL-3.0.</Copyright>
    <Version>0.2.3</Version>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <FileVersion>0.2.3.0</FileVersion>
    <ApplicationIcon>..\v2rayN\Assets\Sora\sora.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win7-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
