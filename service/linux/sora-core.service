[Unit]
Description=Sora core service
Documentation=https://github.com/levvs-one/sora-client/tree/main/service/linux
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
# The core runs as its own account: the kill switch lets the engines' traffic
# through by uid, and the interface reaches the core through the socket.
User=sora
Group=sora
ExecStart=/usr/bin/sora-core -data-dir /var/lib/sora -engines-dir /usr/lib/sora/engines
Restart=on-failure
RestartSec=2s
# Stopping restores the system proxy and removes the nftables table; give it
# time before the kill.
TimeoutStopSec=15s

StateDirectory=sora
StateDirectoryMode=0700
RuntimeDirectory=sora
# The person polkit admits is not in the sora group and must reach the socket;
# the core refuses every other account on accept.
RuntimeDirectoryMode=0755
UMask=0077

# tun devices, routes and the nftables kill switch need CAP_NET_ADMIN; the
# engines are children and inherit the ambient set.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes

DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
